<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>单视频空间重建试验</title>
<style>*{box-sizing:border-box}body{margin:0;font:15px/1.7 system-ui,"Microsoft YaHei",sans-serif;background:#edf1f3;color:#203940}header{background:#173944;color:#fff;padding:26px 4vw}h1{font-size:27px;margin:0}header p{margin:5px 0;color:#c0d9de}main{padding:24px 4vw;max-width:1800px;margin:auto}section{background:#fff;border:1px solid #d4dfe3;border-radius:10px;padding:20px;margin-bottom:22px}h2{font-size:20px;margin:0 0 10px}p{margin:8px 0}.status{display:flex;gap:12px;flex-wrap:wrap}.pill{background:#e8f0ef;border-radius:6px;padding:8px 14px}a{color:#176a78}button,select,input{font:inherit;border:1px solid #a7bdc6;border-radius:5px;padding:6px 10px;background:#fff;color:#203940}button{cursor:pointer}button:hover{background:#e8f0ef}.tools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:12px 0}.viewport{display:grid;grid-template-columns:280px 1fr;gap:16px}canvas{display:block;width:100%;height:62vh;min-height:380px;background:#142330;border-radius:7px;touch-action:none}.planes{max-height:62vh;overflow:auto}.planes button{display:block;width:100%;text-align:left;margin:4px 0}.planes button.active{background:#d4e9e6;border-color:#1b7a75}.edit{display:grid;gap:10px;margin:12px 0}.edit label{display:grid;gap:3px}.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}.card{border:1px solid #d9e3e7;border-radius:7px;overflow:hidden;background:#f8fafb}.card img{display:block;width:100%;height:310px;object-fit:contain;background:#e5ebee}.card div{padding:10px;font-size:13px}.muted{color:#627d87}.notice{padding:12px 16px;border-left:4px solid #e7b859;background:#fff8e8}video{max-width:360px;max-height:500px;display:block}details summary{cursor:pointer}#error{color:#9b2535;white-space:pre-wrap}@media(max-width:850px){.viewport{grid-template-columns:1fr}.planes{max-height:180px}canvas{height:52vh}main{padding:15px}}</style>
<header><h1>单视频空间重建试验</h1><p>一段视频 → 重建用帧与结构参考帧 → 扫描平面候选</p><p id="input-summary"></p></header>
<main><section><h2>本轮结果</h2><div class="status" id="status"></div><p id="finding"></p><p class="notice" id="dimensions"></p><p id="links"></p><pre id="error" hidden></pre></section>
<section><h2>扫描与可编辑平面候选</h2><p id="plane-note"></p><div class="tools"><button id="reset">重置视角</button><button id="xy">XY</button><button id="xz">XZ</button><button id="yz">YZ</button><label><input type="checkbox" id="points" checked> 扫描采样点</label><label><input type="checkbox" id="patches" checked> 拟合平面</label><span class="muted">拖动旋转 · 滚轮缩放</span></div><div class="viewport"><aside><div class="planes" id="plane-list"></div><div class="edit" id="edit" hidden><label>名称<input id="name"></label><label>结构类型<select id="type"><option value="unclassified">待分类</option><option value="wall">墙</option><option value="floor">地板</option><option value="ceiling">顶面</option><option value="ceiling_candidate">顶面候选</option><option value="window_wall_candidate">含窗立面片</option><option value="door_leaf_candidate">门扇所在片</option><option value="equipment_candidate">设备所在片</option><option value="door_candidate">门候选</option><option value="window_candidate">窗候选</option><option value="other">其他</option></select></label><label><span id="unit-label">沿法线移动（扫描坐标单位）</span><input id="offset" type="number" step="0.01" value="0"></label><label><input id="visible" type="checkbox" checked> 显示此平面</label><button id="apply">应用调整</button><img id="plane-image" style="width:100%;height:auto" hidden><p id="plane-review" class="muted"></p></div><button id="export">导出当前平面 JSON</button><p class="muted">金色轮廓为观测边界；粉色为扫描缺失区。缺失区尚未确认为门窗。</p></aside><canvas id="view"></canvas></div></section>
<section><h2>视频抽帧与结构依据</h2><p>自动按时间段选取清晰帧。补选帧仍来自同一段视频。下列标注说明画面中看到了什么，三维门窗范围仍需与扫描几何核对。</p><div class="gallery" id="gallery"></div></section>
<section><details><summary>原始视频与尺寸来源</summary><p id="source-note"></p><video id="video" controls preload="metadata"></video></details></section></main>
<script>
const result=__RESULT_DATA__;
try {
const $=id=>document.getElementById(id),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
$('input-summary').textContent=`${result.duration.toFixed(2)} 秒原视频 · ${result.frame_count} 张重建帧 · ${result.references.length} 张结构参考帧 · 额外源照片 0 张`;
$('status').innerHTML=result.status.map(s=>`<span class="pill">${esc(s)}</span>`).join('');$('finding').textContent=result.finding;$('dimensions').textContent=result.dimension_note;
$('links').innerHTML=result.links.map(l=>`<a href="${esc(l.url)}">${esc(l.label)}</a>`).join(' · ');
$('source-note').textContent='输入只有视频。已知尺寸来自对话确认或运行参数，保存在项目元数据中。抽帧图片均为程序输出。';$('video').src=result.video_url;
$('gallery').innerHTML=result.references.map(f=>`<article class="card"><a href="${esc(f.url)}"><img loading="lazy" src="${esc(f.url)}" alt="视频帧 ${esc(f.id)}"></a><div><b>${esc(f.id)} · ${f.seconds.toFixed(3)} 秒</b><br>原视频帧号 ${f.source_frame_index}<br>${esc(f.tags.join('、'))}<p>${esc(f.note)}</p></div></article>`).join('');
const model=result.structure||{planes:[]},planes=model.planes;const aligned=!!result.provisionally_aligned;$('unit-label').textContent=aligned?'沿法线移动（暂定米制单位）':'沿法线移动（扫描坐标单位）';let selected=planes.findIndex(p=>p.semantic_type==='floor');if(selected<0)selected=planes.length?0:-1;
$('plane-note').textContent=planes.length?`已从本轮扫描拟合 ${planes.length} 个观测平面片。${aligned?'已暂按层高摆正和统一缩放，净尺寸尚未验证。':'当前以原始扫描坐标显示，尚未完成统一尺寸定标。'}可单独命名、分类、移动或隐藏；修改后需要导出保存。`:'本轮扫描尚未返回，当前显示本地点云的一个独立片段。完成云端分析后重新生成此页面即可查看平面候选。';
const canvas=$('view'),ctx=canvas.getContext('2d');const raw=result.points;let yaw=.6,pitch=-.35,zoom=1,drag=null;
const coords=raw.map(p=>p.slice(0,3));if(!coords.length)coords.push([0,0,0],[1,1,1]);
const sorted=[0,1,2].map(k=>coords.map(p=>p[k]).sort((a,b)=>a-b));const lo=sorted.map(a=>a[Math.floor(a.length*.01)]),hi=sorted.map(a=>a[Math.min(a.length-1,Math.floor(a.length*.99))]);const center=lo.map((v,k)=>(v+hi[k])/2),extent=Math.max(...hi.map((v,k)=>v-lo[k]),.001);
function project(p){let [x,y,z]=p.map((v,k)=>(v-center[k])/extent);let a=x*Math.cos(yaw)+z*Math.sin(yaw),b=-x*Math.sin(yaw)+z*Math.cos(yaw),c=y*Math.cos(pitch)-b*Math.sin(pitch),d=y*Math.sin(pitch)+b*Math.cos(pitch);return [canvas.width/2+a*canvas.height*.8*zoom,canvas.height/2-c*canvas.height*.8*zoom,d]}
function world(p,uv){return p.origin.map((v,k)=>v+p.basis_uv[0][k]*uv[0]+p.basis_uv[1][k]*uv[1]+p.normal[k]*(p.edit_offset||0))}
function draw(){let r=canvas.getBoundingClientRect(),dpr=devicePixelRatio||1;canvas.width=r.width*dpr;canvas.height=r.height*dpr;ctx.fillStyle='#142330';ctx.fillRect(0,0,canvas.width,canvas.height);
if($('points').checked)for(const p of raw){if(!p.slice(0,3).every((v,k)=>v>=lo[k]&&v<=hi[k]))continue;let xy=project(p);ctx.fillStyle=`rgb(${p.slice(3,6).map(v=>Math.min(255,v+20)).join(',')})`;ctx.fillRect(xy[0],xy[1],2*dpr,2*dpr)}
if($('patches').checked){const order=planes.map((p,i)=>({p,i,z:project(p.origin)[2]})).sort((a,b)=>a.z-b.z);for(const {p,i} of order){if(p.edit_visible===false)continue;ctx.beginPath();for(const loop of p.contours){loop.uv.forEach((uv,j)=>{let xy=project(world(p,uv));j?ctx.lineTo(xy[0],xy[1]):ctx.moveTo(xy[0],xy[1])});ctx.closePath()}ctx.fillStyle=i===selected?'#6cc4b52e':'#91bdd016';ctx.fill('evenodd');for(const loop of p.contours){ctx.beginPath();loop.uv.forEach((uv,j)=>{let xy=project(world(p,uv));j?ctx.lineTo(xy[0],xy[1]):ctx.moveTo(xy[0],xy[1])});ctx.closePath();ctx.strokeStyle=loop.kind==='unknown_gap'?'#e986a4':i===selected?'#65efd2':'#e5bd76';ctx.lineWidth=i===selected?2*dpr:dpr;ctx.stroke()}const xy=project(p.origin);ctx.fillStyle='#fff';ctx.font=`${12*dpr}px system-ui`;ctx.fillText(p.edit_name||p.id,xy[0]+3,xy[1]-3)}}}
function select(i){selected=i;renderList();const p=planes[i];$('edit').hidden=!p;if(p){$('name').value=p.edit_name||p.id;$('type').value=p.semantic_type;$('offset').value=p.edit_offset||0;$('visible').checked=p.edit_visible!==false;const preview=result.plane_previews?.[p.id];$('plane-image').hidden=!preview;if(preview)$('plane-image').src=preview;$('plane-review').textContent=p.semantic_review||'该平面的结构语义尚未核对。'}draw()}
function renderList(){$('plane-list').innerHTML='';planes.forEach((p,i)=>{const b=document.createElement('button');b.textContent=(p.edit_name||p.id)+' · '+p.sample_support+' 点';b.className=i===selected?'active':'';b.onclick=()=>select(i);$('plane-list').append(b)})}
$('apply').onclick=()=>{const p=planes[selected];if(!p)return;const value=Number($('offset').value);if(!Number.isFinite(value))return;p.edit_name=$('name').value;p.semantic_type=$('type').value;p.edit_offset=value;p.edit_visible=$('visible').checked;p.classification_source='user_edit_unverified';renderList();draw()};
$('export').onclick=()=>{const blob=new Blob([JSON.stringify(model,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='edited_observed_planes.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
canvas.onpointerdown=e=>{drag=[e.clientX,e.clientY];canvas.setPointerCapture(e.pointerId)};canvas.onpointermove=e=>{if(!drag)return;yaw+=(e.clientX-drag[0])*.008;pitch+=(e.clientY-drag[1])*.008;drag=[e.clientX,e.clientY];draw()};canvas.onpointerup=()=>drag=null;canvas.onpointercancel=()=>drag=null;canvas.onwheel=e=>{e.preventDefault();zoom=Math.max(.1,Math.min(12,zoom*Math.exp(-e.deltaY*.001)));draw()};$('reset').onclick=()=>{yaw=.6;pitch=-.35;zoom=1;draw()};$('xy').onclick=()=>{yaw=0;pitch=0;draw()};$('xz').onclick=()=>{yaw=0;pitch=Math.PI/2;draw()};$('yz').onclick=()=>{yaw=Math.PI/2;pitch=0;draw()};$('points').onchange=$('patches').onchange=draw;window.onresize=draw;select(selected);
}catch(error){const panel=document.getElementById('error');panel.hidden=false;panel.textContent='页面初始化失败：'+error.message;}
</script></html>
