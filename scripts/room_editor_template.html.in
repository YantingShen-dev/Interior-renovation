<!doctype html><!-- Build input: generate with build_editable_room.py; open the generated editor. -->
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>房间结构校正</title>
<style>*{box-sizing:border-box}body{margin:0;background:#eef1f4;color:#1b2c3c;font:14px system-ui,"Microsoft YaHei",sans-serif}header{padding:18px 24px;background:#152c3b;color:#fff;display:flex;align-items:center;gap:22px;flex-wrap:wrap}h1{font-size:21px;margin:0}header p{margin:4px 0;color:#b4cbd9;font-size:12px}.badge{margin-left:auto;color:#b4e6de;font-variant-numeric:tabular-nums}.layout{display:grid;grid-template-columns:320px 1fr;min-height:calc(100vh - 83px)}aside{background:#fff;border-right:1px solid #d5dfe7;padding:18px;overflow:auto;max-height:calc(100vh - 83px)}h2{font-size:14px;margin:0 0 10px}.section{border-bottom:1px solid #e0e6ec;padding-bottom:18px;margin-bottom:18px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}label.field{font-size:12px;color:#52687a}input[type=number],select{display:block;width:100%;padding:8px;margin-top:4px;border:1px solid #c9d4dd;border-radius:5px;background:#fff;color:#243a4c}button{border:1px solid #becdd8;border-radius:5px;background:#f5f8fa;color:#243f54;padding:8px 10px;cursor:pointer;font:inherit}button.primary{background:#17685f;color:white;border-color:#17685f}button:hover{filter:brightness(.96)}button:disabled{opacity:.4;cursor:default}.buttons{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.hint{font-size:12px;line-height:1.65;color:#667c8e;margin:10px 0}.warning{color:#91651e;background:#fff7e6;border:1px solid #efddbb;padding:9px;border-radius:5px;font-size:12px;line-height:1.7}main{min-width:0;position:relative}.toolbar{display:flex;align-items:center;gap:10px;padding:12px 18px;background:#fff;border-bottom:1px solid #d5dfe7;flex-wrap:wrap}.toolbar label{font-size:12px;display:flex;gap:4px;align-items:center}canvas{display:block;width:100%;height:calc(100vh - 230px);min-height:470px;touch-action:none}.caption{padding:10px 20px;font-size:12px;line-height:1.8;color:#61788a}.status{font-size:12px;line-height:1.7;padding:8px 18px;background:#e2eeea;color:#27594e;min-height:36px}.error{background:#f9e5e2;color:#934536}#entityFact{white-space:pre-line}input[type=file]{display:none}.legend{margin-left:auto;font-size:12px;color:#63798a}.legend span{margin-left:10px}@media(max-width:900px){.layout{grid-template-columns:260px 1fr}aside{padding:12px}.toolbar{gap:6px}}@media(max-width:680px){.layout{display:block}aside{max-height:none}.fields{grid-template-columns:repeat(3,1fr)}canvas{height:60vh}header{padding:14px}.badge{margin-left:0}}</style></head><body>
<header><div><h1>房间结构校正</h1><p>实测尺寸建立轮廓 · 扫描辅助定位 · 门窗候选待确认</p></div><div class="badge" id="roomBadge"></div></header>
<div class="layout"><aside>
<div class="section"><h2>房间内侧尺寸</h2><div class="fields"><label class="field">长 / 米<input id="roomLength" type="number" step=".01" min=".1"></label><label class="field">宽 / 米<input id="roomWidth" type="number" step=".01" min=".1"></label><label class="field">高 / 米<input id="roomHeight" type="number" step=".01" min=".1"></label></div><div class="buttons"><button id="applyRoom">同步房间轮廓</button></div><p class="hint">初始 4 × 1.8 × 3 米来自你的实测。模型墙厚用于显示，尚未实测。</p></div>
<div class="section"><h2>选择墙体或门窗</h2><select id="entitySelect"></select><p id="entityFact" class="hint"></p><details id="evidenceBlock"><summary style="font-size:12px;cursor:pointer;color:#17685f">查看来源照片</summary><div id="evidenceImages"></div></details><div id="entityFields" class="fields"></div><div class="buttons"><button id="applyEntity" class="primary">应用修改</button><button id="removeEntity">删除候选</button></div><div class="buttons"><button id="addDoor">新增门</button><button id="addWindow">新增窗</button></div></div>
<div class="section"><h2>保存与导出</h2><div class="buttons"><button id="undo">撤销</button><button id="redo">重做</button></div><div class="buttons"><button id="saveJSON" class="primary">导出 JSON</button><button id="saveGLB">导出 GLB</button><button id="importJSON">导入 JSON</button><input id="fileInput" type="file" accept=".json,application/json"></div><p class="hint">JSON 保存可继续编辑的参数与来源。GLB 保留独立墙体、门、窗节点和语义标识。</p></div>
<div class="warning">门窗存在依据照片辅助估计的参数，当前未逐项量测。扫描对照采用统一比例，没有按长宽单独拉伸；它与规则轮廓之间的偏差会直接显示。</div>
</aside><main><div class="toolbar"><button id="iso">轴测</button><button id="top">俯视</button><button id="reset">重置视角</button><label><input id="cutaway" type="checkbox" checked> 剖视墙体</label><label><input id="showScan" type="checkbox"> 扫描对照</label><label><input id="showCeiling" type="checkbox"> 顶面</label><div class="legend"><span>灰色 / 墙体</span><span>金色 / 门候选</span><span>蓝色 / 窗候选</span></div></div>
<canvas id="view"></canvas><div class="status" id="status">拖动旋转，滚轮缩放；点击模型或从左侧选择对象。</div><div class="caption">扫描高度已按 3 米作统一比例校正，对侧表面检测宽度约 1.64–2.34 米，未通过 1.8 米净宽核验。当前规则房间是实测约束草模，门窗支持修改和替换。颜色用于区分构件，尚未恢复装修材质。</div></main></div>
<script>__GEOMETRY__</script><script>
const initialScene=__SCENE__;const scanPoints=__SCAN__;const referencePhotos=__PHOTOS__;
let scene=structuredClone(initialScene),selected='window_end',history=[],future=[],parts=[],hitFaces=[];
const $=id=>document.getElementById(id),canvas=$('view'),ctx=canvas.getContext('2d');
let yaw=-.78,pitch=.68,zoom=1,drag=null,dragMoved=false;
function entities(){return [...scene.walls,...scene.openings];}function current(){return entities().find(e=>e.id===selected);}
function message(text,error=false){$('status').textContent=text;$('status').className='status'+(error?' error':'');}
function commit(next){const errors=RoomGeometry.validate(next);if(errors.length){message(errors.join('；'),true);return false;}history.push(structuredClone(scene));future=[];scene=next;refresh();return true;}
function field(key,label,value,step=.01){const wrap=document.createElement('label');wrap.className='field';wrap.textContent=label;const input=document.createElement('input');input.type='number';input.step=step;input.value=value;input.dataset.key=key;wrap.append(input);return wrap;}
function updateSelection(){const e=current();$('entityFields').replaceChildren();if(!e)return;
const isWall=e.kind==='wall';$('entityFact').textContent=isWall?'实测尺寸约束墙体\n端点 '+JSON.stringify(e.start)+' → '+JSON.stringify(e.end):'待确认候选\n'+e.evidence_note;
const evidence=$('evidenceImages');evidence.replaceChildren();for(const name of e.evidence_images||[]){if(!referencePhotos[name])continue;const img=document.createElement('img');img.src=referencePhotos[name];img.alt='来源照片 '+name;img.style.cssText='display:block;width:100%;max-height:280px;object-fit:contain;margin:8px 0;background:#e8eef2';evidence.append(img);}$('evidenceBlock').hidden=!evidence.children.length;
const fields=isWall?[['height','高度 / 米'],['thickness','模型厚度 / 米']]:[['u','沿墙位置 / 米'],['width','宽度 / 米'],['bottom','离地高度 / 米'],['height','高度 / 米']];
if(!isWall&&e.kind==='door'&&e.subtype!=='elevator')fields.push(['open_angle_deg','开启角度 / 度']);
for(const [key,label] of fields)$('entityFields').append(field(key,label,e[key]||0,key==='open_angle_deg'?1:.01));$('removeEntity').disabled=isWall;draw();}
function refresh(){parts=RoomGeometry.buildParts(scene);$('roomLength').value=scene.room.length;$('roomWidth').value=scene.room.width;$('roomHeight').value=scene.room.height;$('roomBadge').textContent=[scene.room.length,scene.room.width,scene.room.height].map(v=>v.toFixed(2)).join(' × ')+' m';
const select=$('entitySelect');select.replaceChildren();for(const e of entities()){const option=document.createElement('option');option.value=e.id;option.textContent=e.label;select.append(option);}if(!current())selected=scene.walls[0].id;select.value=selected;$('undo').disabled=!history.length;$('redo').disabled=!future.length;updateSelection();}
$('entitySelect').onchange=()=>{selected=$('entitySelect').value;updateSelection();};
$('applyEntity').onclick=()=>{const next=structuredClone(scene),e=[...next.walls,...next.openings].find(x=>x.id===selected);for(const input of $('entityFields').querySelectorAll('input'))e[input.dataset.key]=Number(input.value);e.edit_status='user_edited';if(commit(next))message('修改已应用。导出 JSON 可保存当前参数。');};
$('applyRoom').onclick=()=>{const next=structuredClone(scene),L=Number($('roomLength').value),W=Number($('roomWidth').value),H=Number($('roomHeight').value);next.room={...next.room,length:L,width:W,height:H,dimension_source:'editor_user_input',height_confirmed:false};const positions={wall_side_a:[[0,0],[L,0]],wall_side_b:[[0,W],[L,W]],wall_window:[[0,0],[0,W]],wall_door_end:[[L,0],[L,W]]};for(const w of next.walls){[w.start,w.end]=positions[w.id];w.height=H;}if(commit(next))message('房间轮廓已同步；扫描对照保持原有统一比例。新输入尺寸未自动标为已实测确认。');};
$('removeEntity').onclick=()=>{const e=current();if(!e||e.kind==='wall')return;const next=structuredClone(scene);next.openings=next.openings.filter(o=>o.id!==selected);if(commit(next))message('候选已移除，可以撤销。');};
function addOpening(kind){const next=structuredClone(scene);const chosen=current();const w=chosen?.kind==='wall'?next.walls.find(v=>v.id===chosen.id):next.walls.find(v=>v.id===chosen?.wall_id)||next.walls[0];const intervals=next.openings.filter(o=>o.wall_id===w.id).map(o=>[o.u,o.u+o.width]).sort((a,b)=>a[0]-b[0]);let start=.08;for(const [a,b]of intervals){if(a-start>=.75)break;start=Math.max(start,b+.08);}if(RoomGeometry.length(w)-start<.72){message('这面墙没有足够空位，请先选择另一面墙或调整现有洞口。',true);return;}const o={id:kind+'_'+Date.now(),label:kind==='door'?'新增门候选':'新增窗候选',kind,subtype:kind==='door'?'hinged':'assembly',wall_id:w.id,u:start,width:.68,bottom:kind==='door'?0:.7,height:kind==='door'?Math.min(2.1,w.height-.1):Math.min(1.1,w.height-.8),open_angle_deg:0,status:'user_added_candidate',dimensions_verified:false,evidence_note:'用户新建，尺寸尚未量测确认。'};next.openings.push(o);selected=o.id;if(commit(next))message('已新增候选，可继续修改参数。');}
$('addDoor').onclick=()=>addOpening('door');$('addWindow').onclick=()=>addOpening('window');
$('undo').onclick=()=>{if(!history.length)return;future.push(structuredClone(scene));scene=history.pop();refresh();message('已撤销。');};$('redo').onclick=()=>{if(!future.length)return;history.push(structuredClone(scene));scene=future.pop();refresh();message('已重做。');};
function download(bytes,name,type){const url=URL.createObjectURL(new Blob([bytes],{type})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
$('saveJSON').onclick=()=>download(JSON.stringify(scene,null,2),'room.scene.json','application/json');$('saveGLB').onclick=()=>{try{download(RoomGeometry.exportGLB(scene),'editable_room.glb','model/gltf-binary');message('当前结构已导出为 GLB；候选状态与来源保存在节点元数据中。');}catch(e){message(e.message,true);}};
$('importJSON').onclick=()=>$('fileInput').click();$('fileInput').onchange=async()=>{try{const file=$('fileInput').files[0];if(!file)return;const data=JSON.parse(await file.text());if(data.schema_version!=='room-pilot-1')throw new Error('文件不是当前房间参数格式');if(commit(data))message('参数文件已导入。');}catch(e){message('导入失败：'+e.message,true);}finally{$('fileInput').value='';}};
function project(p,width,height){const target=[scene.room.length/2,scene.room.width/2,scene.room.height/2],v=p.slice(0,3).map((x,i)=>x-target[i]);const right=[Math.cos(yaw),Math.sin(yaw),0],fwd=[-Math.sin(yaw),Math.cos(yaw),0],sp=Math.sin(pitch),cp=Math.cos(pitch);const xx=v[0]*right[0]+v[1]*right[1],horizontal=v[0]*fwd[0]+v[1]*fwd[1],yy=-sp*horizontal+cp*v[2],depth=cp*horizontal+sp*v[2],scale=Math.min(width/(scene.room.length+scene.room.width+1.2),height/(scene.room.height+scene.room.width+1.2))*zoom;return [width/2+xx*scale,height/2-yy*scale,depth];}
function draw(){const rect=canvas.getBoundingClientRect(),dpr=devicePixelRatio||1,W=rect.width,H=rect.height;canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);ctx.fillStyle='#edf2f5';ctx.fillRect(0,0,W,H);hitFaces=[];const fwd=[-Math.sin(yaw)*Math.cos(pitch),Math.cos(yaw)*Math.cos(pitch),Math.sin(pitch)];
if($('showScan').checked){ctx.globalAlpha=.5;for(let i=0;i<scanPoints.length;i+=3){const p=scanPoints[i],v=project(p,W,H);ctx.fillStyle=`rgb(${p.slice(3).join(',')})`;ctx.fillRect(v[0],v[1],1.5,1.5);}ctx.globalAlpha=1;}
const faces=[];for(const part of parts){if(part.role==='ceiling'&&!$('showCeiling').checked)continue;const wall=scene.walls.find(w=>w.id===part.parent);if(wall&&$('cutaway').checked&&wall.outward[0]*fwd[0]+wall.outward[1]*fwd[1]>0.02&&part.parent!==selected)continue;for(const box of part.boxes){const vertices=RoomGeometry.boxVertices(box);for(const q of RoomGeometry.quads){const xyz=q.map(i=>vertices[i]),screen=xyz.map(p=>project(p,W,H));const u=xyz[1].map((v,i)=>v-xyz[0][i]),v=xyz[2].map((v,i)=>v-xyz[0][i]);let n=[u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]];const norm=Math.hypot(...n);n=n.map(v=>v/norm);faces.push({screen,color:part.color,depth:screen.reduce((a,p)=>a+p[2],0)/4,id:part.parent,normal:n});}}}
faces.sort((a,b)=>a.depth-b.depth);for(const face of faces){const path=new Path2D();face.screen.forEach((p,i)=>i?path.lineTo(p[0],p[1]):path.moveTo(p[0],p[1]));path.closePath();const light=.72+.28*Math.max(0,face.normal[2]*.8-face.normal[0]*.3-face.normal[1]*.25);ctx.fillStyle=`rgba(${face.color.slice(0,3).map(v=>Math.round(v*255*light)).join(',')},${face.color[3]})`;ctx.fill(path);ctx.strokeStyle=face.id===selected?'#c1872a':'rgba(59,83,100,.22)';ctx.lineWidth=face.id===selected?1.5:.5;ctx.stroke(path);hitFaces.push({path,id:face.id});}
ctx.fillStyle='#647d8e';ctx.font='12px system-ui';ctx.fillText('米制 · Z 向上 · 剖视不会删除模型墙体',16,H-18);}
canvas.onpointerdown=e=>{drag=[e.clientX,e.clientY];dragMoved=false;canvas.setPointerCapture(e.pointerId);};canvas.onpointermove=e=>{if(!drag)return;const dx=e.clientX-drag[0],dy=e.clientY-drag[1];if(Math.abs(dx)+Math.abs(dy)>1)dragMoved=true;yaw+=dx*.007;pitch=Math.max(.05,Math.min(Math.PI/2,pitch+dy*.007));drag=[e.clientX,e.clientY];draw();};canvas.onpointerup=e=>{drag=null;if(dragMoved)return;const r=canvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;ctx.save();ctx.setTransform(1,0,0,1,0,0);for(let i=hitFaces.length-1;i>=0;i--)if(ctx.isPointInPath(hitFaces[i].path,x,y)&&entities().some(v=>v.id===hitFaces[i].id)){selected=hitFaces[i].id;$('entitySelect').value=selected;updateSelection();break;}ctx.restore();};canvas.onpointercancel=()=>drag=null;canvas.onwheel=e=>{e.preventDefault();zoom=Math.max(.35,Math.min(3.5,zoom*Math.exp(-e.deltaY*.001)));draw();};
$('iso').onclick=()=>{yaw=-.78;pitch=.68;zoom=1;draw();};$('top').onclick=()=>{yaw=0;pitch=Math.PI/2;zoom=1;draw();};$('reset').onclick=$('iso').onclick;for(const id of ['cutaway','showScan','showCeiling'])$(id).onchange=draw;window.onresize=draw;refresh();
</script></body></html>
