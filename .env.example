# Copy this file to .env.local. Keep real keys out of version control.

TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211
# Optional native TokenHub example:
# TRIPO_PROVIDER=hunyuan
# STUDIO_TRIPO_HUNYUAN_MODEL=hy-3d-3.1
# STUDIO_TRIPO_HUNYUAN_KEY=

# Shared vision + chat + tool-calling model for automatic rooms and layout.
# Chat Completions compatible endpoint, including /v1 when required.
CHAT_API_BASE=
CHAT_MODEL=
CHAT_API_KEY=

# Select native providers in the page settings; each keeps its own credentials.
# Legacy custom / OpenAI-compatible image configuration:
IMAGE_API_BASE=
IMAGE_MODEL=
IMAGE_API_KEY=

# Native examples (uncomment only the provider you want to use):
# IMAGE_PROVIDER=qwen
# STUDIO_IMAGE_QWEN_KEY=
# STUDIO_IMAGE_QWEN_MODEL=qwen-image-2.0-pro
# STUDIO_IMAGE_QWEN_BASE=https://dashscope.aliyuncs.com/api/v1
# IMAGE_PROVIDER=hunyuan
# STUDIO_IMAGE_HUNYUAN_ACCESS_ID=
# STUDIO_IMAGE_HUNYUAN_KEY=
# IMAGE_PROVIDER=kling
# STUDIO_IMAGE_KLING_AUTH_MODE=key
# STUDIO_IMAGE_KLING_KEY=
# For legacy Kling AK/SK: AUTH_MODE=pair; ACCESS_ID=Access Key; KEY=Secret Key.

# Configure once via the home page. Legacy VISION_* overrides are no longer read.

# Optional: comma-separated hosts to reach directly, preserving proxy for other hosts.
STUDIO_DIRECT_HOSTS=
# TokenHub: auto, direct, or proxy. A proxy must be explicitly configured.
STUDIO_HUNYUAN_ROUTE=auto
# Optional executable for local video frame extraction.
# STUDIO_FFMPEG_PATH=
